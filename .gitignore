node_modules/
dist/
.env
.env.local
.DS_Store
npm-debug.log*
__pycache__/
*.pyc

# Local-only large data. Raw CSVs, DuckDB files, and exports must never be
# committed or uploaded to GitHub.
local_data/*
!local_data/README.md
!local_data/inbox/
local_data/inbox/*
!local_data/inbox/.gitkeep
!local_data/exports/
local_data/exports/*
!local_data/exports/.gitkeep

# The compatibility master snapshot can exceed GitHub's single-file limit.
# Commit the generated index and chunk directory instead.
public/data/master-catalog.json
