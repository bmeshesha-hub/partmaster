VITE_GITHUB_OWNER=bmeshesha-hub
VITE_GITHUB_DATA_REPO=partmaster_data
VITE_GITHUB_BRANCH=main
VITE_BASE_PATH=/partmaster/

# Local DuckDB and evidence-worker limits. These are read by `npm run dev:local`.
PARTMASTER_THREADS=4
PARTMASTER_MEMORY_LIMIT=4GB
PARTMASTER_FETCH_TIMEOUT_MS=15000
PARTMASTER_MAX_PAGE_BYTES=2000000
PARTMASTER_DATABASE_PATH=local_data/partmaster.rebuilt.duckdb
PARTMASTER_SKIP_VEHICLE_MAPPING_STARTUP=true

# Optional Google Drive archive for approved, immutable master snapshots.
# Keep DuckDB local; this folder is only a published-file destination.
PARTMASTER_DRIVE_MASTERDATA_DIR=/Users/bmeshesha/Library/CloudStorage/GoogleDrive-bmeshesha@ebay.com/Shared drives/Partmaster/Masterdata/exports

# Optional link shown in the Master Data export screen. Use the Drive share
# link for master-catalog-latest.json, not the working/raw-data folder.
VITE_GOOGLE_DRIVE_MASTERDATA_URL=
